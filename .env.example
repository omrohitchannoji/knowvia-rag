# Application Settings
APP_NAME=Knowvia AI
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# FastAPI Backend Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["*"]

# Streamlit Frontend Settings
API_BASE_URL=http://fastapi-backend:8000/api/v1

# LLM Provider Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.0

# Embedding Model Configuration
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Vector DB Configuration (Qdrant)
VECTOR_DB_TYPE=qdrant
QDRANT_STORAGE_PATH=./qdrant_data
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
COLLECTION_NAME=tech_doc_collection

# Retrieval & Hybrid Fusion Parameters
TOP_K_DENSE=10
TOP_K_BM25=10
DENSE_WEIGHT=0.5
BM25_WEIGHT=0.5
RERANK_TOP_N=5
RELEVANCE_THRESHOLD=0.3

# Answerability & Evidence Assessment Thresholds
ANSWERABILITY_STRONG_THRESHOLD=0.65
ANSWERABILITY_PARTIAL_THRESHOLD=0.20
MIN_SUPPORTING_DOCS=1
